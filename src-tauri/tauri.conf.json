{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torque",
  "version": "0.1.0",
  "identifier": "app.torque.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Torque",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "backgroundColor": [13, 16, 15, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
