{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torque",
  "version": "0.3.1",
  "identifier": "app.torque.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Torque",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "backgroundColor": [
          13,
          16,
          15,
          255
        ]
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMTk2NEMxOTA0OEFCMzUKUldRMXEwaVF3V1Fab3ZtWm1BbzREamNEMzBSb0dPRFJ3L3FwYnN4K0FvMU13R0tDdVFIK0NKOHoK",
      "endpoints": [
        "https://github.com/0xPolybit/torque/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
